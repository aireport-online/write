<Application x:Class="Write.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Light"
             ShutdownMode="OnLastWindowClose">
    <Application.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <SolidColorBrush x:Key="AccentBrush" Color="#0F766E"/>
        <SolidColorBrush x:Key="InkBrush" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="ChromeBrush" Color="#F7F8F8"/>
        <SolidColorBrush x:Key="ChromeLineBrush" Color="#DDE1E3"/>
        <SolidColorBrush x:Key="WorkspaceBrush" Color="#E9ECEE"/>

        <!-- Toolbar icons drawn on a 16×16 grid -->
        <Geometry x:Key="IcoAlignLeft">M2,3.5 H14 M2,6.5 H9.5 M2,9.5 H14 M2,12.5 H9.5</Geometry>
        <Geometry x:Key="IcoAlignCenter">M2,3.5 H14 M4.5,6.5 H11.5 M2,9.5 H14 M4.5,12.5 H11.5</Geometry>
        <Geometry x:Key="IcoAlignRight">M2,3.5 H14 M6.5,6.5 H14 M2,9.5 H14 M6.5,12.5 H14</Geometry>
        <Geometry x:Key="IcoJustify">M2,3.5 H14 M2,6.5 H14 M2,9.5 H14 M2,12.5 H14</Geometry>
        <Geometry x:Key="IcoBullets">M2.6,4 h0.8 M2.6,8 h0.8 M2.6,12 h0.8 M6.5,4 H14 M6.5,8 H14 M6.5,12 H14</Geometry>
        <Geometry x:Key="IcoListLines">M7,4 H14 M7,8 H14 M7,12 H14</Geometry>
        <Geometry x:Key="IcoOutdent">M2,3.5 H14 M8,6.5 H14 M8,9.5 H14 M2,12.5 H14 M5.5,5.8 L3,8 L5.5,10.2</Geometry>
        <Geometry x:Key="IcoIndent">M2,3.5 H14 M8,6.5 H14 M8,9.5 H14 M2,12.5 H14 M3,5.8 L5.5,8 L3,10.2</Geometry>
        <Geometry x:Key="IcoTable">M2.5,3.5 H13.5 V12.5 H2.5 Z M2.5,6.5 H13.5 M2.5,9.5 H13.5 M6.2,3.5 V12.5 M9.8,3.5 V12.5</Geometry>
        <Geometry x:Key="IcoPageBreak">M4,2 V5.5 H12 V2 M2,8 H5 M6.5,8 H9.5 M11,8 H14 M4,14 V10.5 H12 V14</Geometry>
        <Geometry x:Key="IcoLineSpacing">M7.5,3.5 H14 M7.5,8 H14 M7.5,12.5 H14 M3.5,3 V13 M1.8,4.7 L3.5,3 L5.2,4.7 M1.8,11.3 L3.5,13 L5.2,11.3</Geometry>
        <Geometry x:Key="IcoChevron">M0.5,0.5 L3.5,3.5 L6.5,0.5</Geometry>

        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource InkBrush}"/>
            <Setter Property="StrokeThickness" Value="1.25"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LetterIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="500"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26000000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="500"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14000000"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#240F766E"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#660F766E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26000000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolSeparator" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Fill" Value="{StaticResource ChromeLineBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Application.Resources>
</Application>
