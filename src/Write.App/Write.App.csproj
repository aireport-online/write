<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Write</AssemblyName>
    <RootNamespace>Write.Desktop</RootNamespace>
    <ApplicationIcon>Assets\write.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>Write</AssemblyTitle>
    <Description>Tekstverwerker voor Word-documenten (.docx)</Description>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Write.Core\Write.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\write.ico" />
  </ItemGroup>
</Project>
